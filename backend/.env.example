DEMO_MODE=true

# ============================================
# 🔧 HOTELPRO BACKEND - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values

# ============ SERVER CONFIGURATION ============
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
API_DOCS_URL=http://localhost:5000/api/docs

# ============ DATABASE CONFIGURATION ============
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hotelpro_saas
DB_USER=hotelpro
DB_PASSWORD=YourSecurePassword123
DB_AUTO_SYNC=true
DB_FORCE_SYNC=false
DB_LOGGING=false
DB_SEED=true

# ============ JWT CONFIGURATION ============
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-12345
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production-67890
JWT_REFRESH_EXPIRE=30d

# ============ OTP CONFIGURATION ============
OTP_EXPIRY=10

# ============ EMAIL CONFIGURATION (SMTP) ============
# Gmail Example:
# 1. Enable 2FA on Gmail account
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use that 16-character password below

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=noreply@hotelpro.in

# Alternative: SendGrid
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxxxxxxxxxxx

# ============ SMS CONFIGURATION (Twilio) ============
# Get these from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=AC_XXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your-auth-token-xxxxxxxxxxxxx
TWILIO_FROM_PHONE=+1234567890

# ============ SECURITY CONFIGURATION ============
BCRYPT_ROUNDS=10
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=1800000

# ============ STRIPE CONFIGURATION (Phase 5) ============
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# ============ RAZORPAY CONFIGURATION (Phase 5) ============
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxx

# ============ AWS CONFIGURATION (Phase 8) ============
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIA_XXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxx
AWS_S3_BUCKET=hotelpro-files

# ============ LOGGING CONFIGURATION ============
LOG_LEVEL=info
LOG_FORMAT=json

# ============ CACHE CONFIGURATION (Phase 3) ============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============ EXTERNAL INTEGRATIONS (Phase 6) ============
# OTA Integrations
BOOKING_COM_API_KEY=xxxxxxxxxxxxx
AIRBNB_API_KEY=xxxxxxxxxxxxx
AGODA_API_KEY=xxxxxxxxxxxxx

# Payment Gateway Integration
PAYMENT_GATEWAY=razorpay
